# Copy to .env and fill in. Never commit .env. Values below are placeholders.

# Listen address and port. Inside Docker, HOST must be 0.0.0.0.
PORT=20127
HOST=127.0.0.1

# SQLite data directory (db/data.sqlite lives here).
DATA_DIR=./data

# Dashboard login password.
DASHBOARD_PASSWORD=change-me

# JWT signing secret for dashboard sessions. Falls back to <DATA_DIR>/jwt-secret.
JWT_SECRET=change-me-to-a-long-random-string

# OAuth client credentials for providers that need them. Leave empty if unused.
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
IFLOW_OAUTH_CLIENT_SECRET=

# Log filter (tracing env-filter syntax).
RUST_LOG=ninerouter=info
